{
  "name": "arcanum-tarot-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-08",
  "vars": {
    "ALLOWED_ORIGIN": "https://swaggyt00.github.io",
    "GEMINI_GAME_PRIMARY": "true",
    "GEMINI_GAME_MODEL": "gemini-3.5-flash-lite"
  },
  "secrets": {
    "required": [
      "GROQ_API_KEY"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_USAGE_BUDGET",
        "class_name": "AIUsageBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-arcanum-public-budget",
      "new_sqlite_classes": [
        "AIUsageBudget"
      ]
    }
  ]
}
